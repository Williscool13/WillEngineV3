# Compiled shaders
*.spv

# Exclude everything in assets/ including subdirectories
assets/**

# Allow BoxTextured (basic model)
!assets/BoxTextured.glb

# Engine-critical textures
!assets/textures/white.wtexture
!assets/textures/error.wtexture
!assets/textures/brdf_lut.wtexture
!assets/textures/smiling_friend.wtexture
!assets/textures/prototype_texture_dark.wtexture
!assets/textures/prototype_texture_dark_license.txt
# Claude working files (plans, backups, settings)
.claude/

# Byte cache from running the scene generators in scripts/
__pycache__/

# Capture-run PNG output (scripts/capture_run.ps1)
captures/
