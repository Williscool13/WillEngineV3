import common_interop;
import constants_interop;
import model_interop;
import instancing_interop;
import push_constant_interop;

import limits_declarations;
import bindless_declarations;

import shader_functions;

// =============== Shader Summary ============
/* Main geometry pass for opaque objects.
*    Technique: Visibility Buffer
*    Format: RG32
*       R0-7  = Triangle Index
*       R8-31 = Instance Index
*       G0-31 = Meshlet  Index
*
*    Consumes visible meshlets generated by culling (instancing.slang). Whose output is an indirect buffer with:
*      X, Y, 1 task dispatches. Where: TotalMeshlets = Y * MeshHardwareLimit + X
*/

// ==================== Mesh Shader ====================
struct VertexOutput
{
    float4 position : SV_Position;
    nointerpolation uint64_t stableId : COLOR0;
    float clipDistance[1] : SV_ClipDistance;
};

struct PrimitiveOutput
{
    nointerpolation uint2 visibility : COLOR0;
};


[shader("mesh")]
[outputtopology("triangle")]
[numthreads(MESH_SHADER_DISPATCH_X, 1, 1)]
void MeshMain(
    out vertices VertexOutput vertices[MESHLET_MAX_VERTICES],
    out indices uint3 triangles[MESHLET_MAX_TRIANGLES],
    out primitives PrimitiveOutput primitives[MESHLET_MAX_TRIANGLES],
    uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID,
    uniform VisibilityBufferAccumulatePushConstant pc)
{
    uint globalMeshletIndex = gid.x + gid.y * (MAX_MESH_WORK_GROUP_COUNT_X / 2);

    if (globalMeshletIndex >= pc.compactedDispatchBuffer->totalVisibleMeshlets) {
        SetMeshOutputCounts(0, 0);
        return;
    }

    CompactedMeshlet compacted = pc.visibleMeshlets[globalMeshletIndex];
    uint instanceIndex = compacted.instanceIndex;
    uint packedLocal = compacted.meshletIndexWithinLOD;
    uint meshletIndexWithinLOD = packedLocal & 0x3FFFFFFF;
    uint lod = packedLocal >> 30;

    Instance inst = pc.instanceBuffer[instanceIndex];
    Primitive prim = pc.primitiveBuffer[inst.primitiveIndex];
    Model m = pc.modelBuffer[inst.modelIndex];

    uint meshletIndex = prim.meshletOffset[lod] + meshletIndexWithinLOD;
    Meshlet meshlet = pc.meshletBuffer[meshletIndex];
    float4x4 jitteredViewProj = pc.sceneData->viewProj;

    SetMeshOutputCounts(meshlet.meshletVertexCount, meshlet.meshletTriangleCount);

    uint32_t threadIndex = gtid.x;
    for (uint i = threadIndex; i < meshlet.meshletVertexCount; i += MESH_SHADER_DISPATCH_X) {
        uint localVertexIndex = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + i];
        Vertex v = pc.vertexBuffer[meshlet.vertexOffset + localVertexIndex];
        float4 worldPos = mul(m.modelMatrix, float4(v.position, 1.0));
        float4 clipPos = mul(jitteredViewProj, worldPos);

        vertices[i].clipDistance[0] = dot(worldPos.xyz, pc.sceneData->clipPlane.xyz) + pc.sceneData->clipPlane.w;
        vertices[i].position = clipPos;
        vertices[i].stableId = inst.stableId;
    }

    for (uint i = threadIndex; i < meshlet.meshletTriangleCount; i += MESH_SHADER_DISPATCH_X) {
        uint triIndex = meshlet.meshletTriangleOffset + i;
        uint packed = pc.meshletTrianglesBuffer[triIndex];

        uint idx0 = (packed >> 0) & 0xFF;
        uint idx1 = (packed >> 8) & 0xFF;
        uint idx2 = (packed >> 16) & 0xFF;

        triangles[i] = uint3(idx0, idx1, idx2);
        primitives[i].visibility = uint2((meshletIndex << 8) | i, instanceIndex);
    }
}

// ==================== Fragment Shader ====================
struct FragmentOutput {
    uint2 visibilityBuffer : SV_Target0;
    uint2 stableId : SV_Target5;
};

[shader("fragment")]
FragmentOutput FragmentMain(VertexOutput vertexInput, PrimitiveOutput primitiveInput)
{
    FragmentOutput output;
    output.visibilityBuffer = primitiveInput.visibility;
    output.stableId = uint2(uint(vertexInput.stableId & 0xFFFFFFFF), uint(vertexInput.stableId >> 32));
    return output;
}

// ==================== Compute Shader ====================
[shader("compute")]
[numthreads(16, 16, 1)]
void VisibilityBufferResolveMain(uint3 dtid : SV_DispatchThreadID, uniform VisibilityBufferResolvePushConstant pc)
{
    if (dtid.x >= pc.extents.x || dtid.y >= pc.extents.y) {
        return;
    }

    uint2 vis = rdgTexturesUInt2[pc.visibilityBufferIndex].Load(int3(dtid.xy, 0)).xy;

    if (vis.x == 0 && vis.y == 0) {
        return;
    }

    uint meshletIndex = vis.x >> 8;
    uint triangleIndexWithinMeshlet = vis.x & 0xFF;
    uint instanceIndex = vis.y;

    Instance inst = pc.instanceBuffer[instanceIndex];
    Primitive prim = pc.primitiveBuffer[inst.primitiveIndex];
    Model m = pc.modelBuffer[inst.modelIndex];
    // material here for bucketing? Later.


    Meshlet meshlet = pc.meshletBuffer[meshletIndex];
    uint triangleIndex = meshlet.meshletTriangleOffset + triangleIndexWithinMeshlet;

    uint packedTriangle = pc.meshletTrianglesBuffer[triangleIndex];
    uint idx0 = (packedTriangle >> 0) & 0xFF;
    uint idx1 = (packedTriangle >> 8) & 0xFF;
    uint idx2 = (packedTriangle >> 16) & 0xFF;
    uint v0i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx0];
    uint v1i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx1];
    uint v2i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx2];
    Vertex v0 = pc.vertexBuffer[v0i];
    Vertex v1 = pc.vertexBuffer[v1i];
    Vertex v2 = pc.vertexBuffer[v2i];

    // 7. Transform three vertex positions to clip space via model matrix + viewProj

    // 8. Compute screen-space barycentrics from pixel NDC position and three clip-space verts

    // 9. Interpolate UV, normal, tangent using barycentrics

    // 10. Fetch textures (albedo, metalRough, normal map, emissive, occlusion) via material indices

    // 11. Reconstruct world position from depth buffer + inverse viewProj

    // 12. Evaluate BRDF (direct lighting, IBL, AO)

    // 13. Write result to output UAV
}