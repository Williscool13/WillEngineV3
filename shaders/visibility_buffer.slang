import common_interop;
import constants_interop;
import model_interop;
import instancing_interop;
import push_constant_interop;

import limits_declarations;
import bindless_declarations;

import shader_functions;

// =============== Shader Summary ============
/* Main geometry pass for opaque objects.
*    Technique: Visibility Buffer
*    Format: RG32
*       R0-7  = Triangle Index
*       R8-31 = Instance Index
*       G0-31 = Meshlet  Index
*
*    Consumes visible meshlets generated by culling (instancing.slang). Whose output is an indirect buffer with:
*      X, Y, 1 task dispatches. Where: TotalMeshlets = Y * MeshHardwareLimit + X
*/

// ==================== Mesh Shader ====================
struct VertexOutput
{
    float4 position : SV_Position;
    nointerpolation uint64_t stableId : COLOR0;
    nointerpolation uint2 visibility : COLOR1; // .x = meshletIndex, .y = instanceIndex
    float4 currentClipPos : TEXCOORD0;
    float4 prevClipPos : TEXCOORD1;
    float clipDistance[1] : SV_ClipDistance;
};

// Use while they fix https://github.com/shader-slang/slang/issues/7019
// https://anki3d.org/workarounds-for-issues-with-mesh-shaders-vulkan-hlsl
// In the future can pass visibility
struct PrimitiveOutput
{
     [[vk::location(0)]] uint primitiveID : SV_PrimitiveID;

     //[[vk::location(0)]]  nointerpolation uint2 visibility;
     // primitives[i].visibility = uint2((meshletIndex << 8) | i, instanceIndex);
};


[shader("mesh")]
[outputtopology("triangle")]
[numthreads(MESH_SHADER_DISPATCH_X, 1, 1)]
void MeshMain(
    OutputVertices<VertexOutput, MESHLET_MAX_VERTICES> vertices,
    OutputIndices<uint3, MESHLET_MAX_TRIANGLES> triangles,
    OutputPrimitives<PrimitiveOutput, MESHLET_MAX_TRIANGLES> primitives,
    uint3 gid : SV_GroupID,
    uint3 gtid : SV_GroupThreadID,
    uniform VisibilityBufferAccumulatePushConstant pc)
{
    uint globalMeshletIndex = gid.x + gid.y * (MAX_MESH_WORK_GROUP_COUNT_X / 2);

    if (globalMeshletIndex >= pc.compactedDispatchBuffer->totalVisibleMeshlets) {
        SetMeshOutputCounts(0, 0);
        return;
    }

    CompactedMeshlet compacted = pc.visibleMeshlets[globalMeshletIndex];
    uint instanceIndex = compacted.instanceIndex;
    uint packedLocal = compacted.meshletIndexWithinLOD;
    uint meshletIndexWithinLOD = packedLocal & 0x3FFFFFFF;
    uint lod = packedLocal >> 30;

    Instance inst = pc.instanceBuffer[instanceIndex];
    Primitive prim = pc.primitiveBuffer[inst.primitiveIndex];
    Model m = pc.modelBuffer[inst.modelIndex];

    uint meshletIndex = prim.meshletOffset[lod] + meshletIndexWithinLOD;
    Meshlet meshlet = pc.meshletBuffer[meshletIndex];
    float4x4 jitteredViewProj = pc.sceneData->viewProj;
    float4x4 unjitteredViewProj = pc.sceneData->unjitteredViewProj;
    float4x4 unjitteredPrevViewProj = pc.sceneData->unjitteredPrevViewProj;

    SetMeshOutputCounts(meshlet.meshletVertexCount, meshlet.meshletTriangleCount);

    uint32_t threadIndex = gtid.x;
    for (uint i = threadIndex; i < meshlet.meshletVertexCount; i += MESH_SHADER_DISPATCH_X) {
        uint localVertexIndex = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + i];
        Vertex v = pc.vertexBuffer[meshlet.vertexOffset + localVertexIndex];
        float4 worldPos = mul(m.modelMatrix, float4(v.position, 1.0));
        float4 prevWorldPos = mul(m.prevModelMatrix, float4(v.position, 1.0));
        float4 clipPos = mul(jitteredViewProj, worldPos);

        vertices[i].clipDistance[0] = dot(worldPos.xyz, pc.sceneData->clipPlane.xyz) + pc.sceneData->clipPlane.w;
        vertices[i].position = clipPos;
        vertices[i].stableId = inst.stableId;
        vertices[i].visibility = uint2(meshletIndex, instanceIndex);
        vertices[i].currentClipPos = mul(unjitteredViewProj, worldPos);
        vertices[i].prevClipPos = mul(unjitteredPrevViewProj, prevWorldPos);
    }

    for (uint i = threadIndex; i < meshlet.meshletTriangleCount; i += MESH_SHADER_DISPATCH_X) {
        uint triIndex = meshlet.meshletTriangleOffset + i;
        uint packed = pc.meshletTrianglesBuffer[triIndex];

        uint idx0 = (packed >> 0) & 0xFF;
        uint idx1 = (packed >> 8) & 0xFF;
        uint idx2 = (packed >> 16) & 0xFF;

        triangles[i] = uint3(idx0, idx1, idx2);
        primitives[i].primitiveID = i;
    }
}

// ==================== Fragment Shader ====================
struct FragmentOutput {
    uint2 visibilityBuffer : SV_Target0;
    uint2 stableId : SV_Target1;
    float2 velocity : SV_Target2;
};

[shader("fragment")]
FragmentOutput FragmentMain(VertexOutput vertexInput, PrimitiveOutput primitiveInput) //, uint primitiveId : SV_PrimitiveID)
{
    FragmentOutput output;
    output.visibilityBuffer = uint2((vertexInput.visibility.x << 8) | primitiveInput.primitiveID & 0xFF, vertexInput.visibility.y);
    output.stableId = uint2(uint(vertexInput.stableId & 0xFFFFFFFF), uint(vertexInput.stableId >> 32));

    float2 currentNDC = vertexInput.currentClipPos.xy / vertexInput.currentClipPos.w;
    float2 prevNDC = vertexInput.prevClipPos.xy / vertexInput.prevClipPos.w;
    output.velocity = currentNDC - prevNDC;

    return output;
}

// ==================== Barycentric Derivatives ====================
struct BarycentricDeriv
{
    float3 m_lambda;
    float3 m_ddx;
    float3 m_ddy;
};

// Perspective-correct barycentrics + analytic UV derivatives.
// From: http://filmicworlds.com/blog/visibility-buffer-rendering-with-material-graphs/
// pt0/pt1/pt2: clip-space positions; pixelNdc: NDC of current pixel (Y-up convention);
// winSize: viewport dimensions in pixels.
BarycentricDeriv CalcFullBary(float4 pt0, float4 pt1, float4 pt2, float2 pixelNdc, float2 winSize)
{
    BarycentricDeriv ret = (BarycentricDeriv)0;

    float3 invW = rcp(float3(pt0.w, pt1.w, pt2.w));

    float2 ndc0 = pt0.xy * invW.x;
    float2 ndc1 = pt1.xy * invW.y;
    float2 ndc2 = pt2.xy * invW.z;

    float invDet = rcp(determinant(float2x2(ndc2 - ndc1, ndc0 - ndc1)));
    ret.m_ddx = float3(ndc1.y - ndc2.y, ndc2.y - ndc0.y, ndc0.y - ndc1.y) * invDet * invW;
    ret.m_ddy = float3(ndc2.x - ndc1.x, ndc0.x - ndc2.x, ndc1.x - ndc0.x) * invDet * invW;
    float ddxSum = dot(ret.m_ddx, float3(1, 1, 1));
    float ddySum = dot(ret.m_ddy, float3(1, 1, 1));

    float2 deltaVec = pixelNdc - ndc0;
    float interpInvW = invW.x + deltaVec.x * ddxSum + deltaVec.y * ddySum;
    float interpW = rcp(interpInvW);

    ret.m_lambda.x = interpW * (invW[0] + deltaVec.x * ret.m_ddx.x + deltaVec.y * ret.m_ddy.x);
    ret.m_lambda.y = interpW * (0.0f    + deltaVec.x * ret.m_ddx.y + deltaVec.y * ret.m_ddy.y);
    ret.m_lambda.z = interpW * (0.0f    + deltaVec.x * ret.m_ddx.z + deltaVec.y * ret.m_ddy.z);

    ret.m_ddx *= (2.0f / winSize.x);
    ret.m_ddy *= (2.0f / winSize.y);
    ddxSum    *= (2.0f / winSize.x);
    ddySum    *= (2.0f / winSize.y);

    ret.m_ddy *= -1.0f;
    ddySum    *= -1.0f;

    float interpW_ddx = 1.0f / (interpInvW + ddxSum);
    float interpW_ddy = 1.0f / (interpInvW + ddySum);

    ret.m_ddx = interpW_ddx * (ret.m_lambda * interpInvW + ret.m_ddx) - ret.m_lambda;
    ret.m_ddy = interpW_ddy * (ret.m_lambda * interpInvW + ret.m_ddy) - ret.m_lambda;

    return ret;
}

// ==================== Compute Shader ====================
[shader("compute")]
[numthreads(16, 16, 1)]
void VisibilityBufferBarycentricDerivative(uint3 dtid : SV_DispatchThreadID, uniform VisibilityBufferResolvePushConstant pc)
{
    if (dtid.x >= pc.extents.x || dtid.y >= pc.extents.y) {
        return;
    }

    uint2 vis = rdgTexturesUInt2[pc.visibilityBufferIndex].Load(int3(dtid.xy, 0)).xy;

    if (vis.x == 0 && vis.y == 0) {
        return;
    }

    uint meshletIndex = vis.x >> 8;
    uint triangleIndexWithinMeshlet = vis.x & 0xFF;
    uint instanceIndex = vis.y;

    Instance inst = pc.instanceBuffer[instanceIndex];
    Primitive prim = pc.primitiveBuffer[inst.primitiveIndex];
    Model m = pc.modelBuffer[inst.modelIndex];

    Meshlet meshlet = pc.meshletBuffer[meshletIndex];
    uint triangleIndex = meshlet.meshletTriangleOffset + triangleIndexWithinMeshlet;

    uint packedTriangle = pc.meshletTrianglesBuffer[triangleIndex];
    uint idx0 = (packedTriangle >> 0) & 0xFF;
    uint idx1 = (packedTriangle >> 8) & 0xFF;
    uint idx2 = (packedTriangle >> 16) & 0xFF;
    uint v0i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx0];
    uint v1i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx1];
    uint v2i = pc.meshletVerticesBuffer[meshlet.meshletVertexOffset + idx2];
    Vertex v0 = pc.vertexBuffer[meshlet.vertexOffset + v0i];
    Vertex v1 = pc.vertexBuffer[meshlet.vertexOffset + v1i];
    Vertex v2 = pc.vertexBuffer[meshlet.vertexOffset + v2i];

    float4x4 mvp = mul(pc.sceneData->viewProj, m.modelMatrix);
    float4 p0 = mul(mvp, float4(v0.position, 1.0));
    float4 p1 = mul(mvp, float4(v1.position, 1.0));
    float4 p2 = mul(mvp, float4(v2.position, 1.0));

    float2 pixelNDC = (float2(dtid.xy) + 0.5) / float2(pc.extents) * 2.0 - 1.0;

    BarycentricDeriv baryDeriv = CalcFullBary(p0, p1, p2, pixelNDC, float2(pc.extents));
    float3 bary = baryDeriv.m_lambda;

    float2 uv0 = float2(v0.texcoordU, v0.texcoordV);
    float2 uv1 = float2(v1.texcoordU, v1.texcoordV);
    float2 uv2 = float2(v2.texcoordU, v2.texcoordV);

    float2 uvDdx = baryDeriv.m_ddx.x * uv0 + baryDeriv.m_ddx.y * uv1 + baryDeriv.m_ddx.z * uv2;
    float2 uvDdy = baryDeriv.m_ddy.x * uv0 + baryDeriv.m_ddy.y * uv1 + baryDeriv.m_ddy.z * uv2;

    rdgStorageFloat2[pc.barycentricTargetIndex][dtid.xy] = float2(bary.x, bary.y);
    rdgStorageFloat4[pc.derivativeTargetIndex][dtid.xy] = float4(uvDdx, uvDdy);

    // Note: We could interpolate here to avoid another vertex fetch in the subsequent pass.
    //  But this shader will be large, and the barycentrics become useless.
}